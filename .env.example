# Copy to .env and fill in. The server loads it on startup.

# --- Slack (bot token xoxb-..., app-level token xapp-... with connections:write) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Channel where results (and the yes/no questions) are posted. The bot must be invited to it.
SLACK_CHANNEL_ID=C0000000000
# Set to true to connect to Slack so /rfpbot works.
SLACK_BOT_ENABLED=false
# Optional: only these Slack user IDs (comma-separated) may use /rfpbot. Blank = anyone.
# SLACK_ALLOWED_USERS=U0123ABCD,U0456EFGH
# Optional: only this Slack user ID's yes/no answers count. Blank = anyone in the channel.
# RFP_APPROVER=U0123ABCD

# --- Local HTTP API (health, jobs, logs, cancel) ---
PORT=8787
# 127.0.0.1 keeps it local-only.
HOST=127.0.0.1
# Comma-separated API keys, sent as "x-api-key" or "Authorization: Bearer <key>".
API_KEYS=change-me-to-a-long-random-string
AUTH_DISABLED=false

# --- Where things are kept (defaults shown; the Docker image uses /data/...) ---
# Job logs and screenshots, one folder per run.
# DATA_DIR=./data
# RFP counter (email / organization number) and the per-venue 7-day date log. Keep on a persistent volume.
# RFP_STATE_DIR=./state
# The hotel list used by /rfpbot (hotels added from Slack are saved here).
# RFP_HOTELS_CONFIG=./config/rfp-hotels.json

# Hard timeout per run in ms; the guest-rfp-creation task sets its own (2 h).
# JOB_TIMEOUT_MS=1800000
# Runs at the same time (the RFP script also takes a lock, so RFPs run one at a time).
# MAX_CONCURRENT_JOBS=1
